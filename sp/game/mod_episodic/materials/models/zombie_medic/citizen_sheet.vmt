vertexlitgeneric
{
	"$basetexture" "models/zombie_medic/citizen_sheet"
	"$bumpmap" "models/zombie_medic/citizen_sheet_n"
	"$lightwarptexture" "dev/identitylightwarp"

	"$halflambert" "1"
	"$ambientocclusion" "1"

	"$phong" "1"
	"$phongexponent" "40"
	"$phongboost" "5"
	"$phongtint" "[.85 .85 1]"
	"$phongalbedotint" "1"										
	"$phongfresnelranges"	"[.1 .5 1.0]"

	//rimlight parameters
	"$rimlight" "1"
	"$rimlightexponent" "40"
	"$rimlightboost" "0.4"


	"$proxytoggle" "1"
	"Proxies"
	{

		"Equals"
		{

			"srcVar1" "$proxytoggle" // Disable Proxies
			"resultVar" "$color" // The shader parameter to be manipulated

		}

	}

}
